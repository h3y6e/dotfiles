{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_IDE_SKIP_VALID_CHECK": "1",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ENABLE_TOOL_SEARCH": "1",
    "FORCE_HYPERLINK": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(npx -y modern-web-guidance@latest *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git commit --amend *)",
      "Bash(git history *)"
    ],
    "deny": [
      "NotebookEdit",
      "Bash(dd *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(git wt ls)",
      "Bash(git wt list)"
    ],
    "defaultMode": "auto",
    "denyInsteadOfPrompting": true,
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/ghq"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r -f {{ .chezmoi.homeDir }}/.claude/statusline.jq"
  },
  "enabledPlugins": {
    "cc-plugin-diff@builtin": false,
    "figma@claude-plugins-official": false,
    "mermaid@h3y6e": true,
    "dubbed@h3y6e": true,
    "napkin@h3y6e": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "h3y6e": {
      "source": {
        "source": "github",
        "repo": "h3y6e/claude-plugins"
      }
    }
  },
  "outputStyle": "Concise",
  "language": "Japanese",
  "sandbox": {
    "enabled": false,
    "network": {
      "allowedDomains": [
        "*"
      ],
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "{{ .chezmoi.homeDir }}"
      ]
    },
    "enableWeakerNetworkIsolation": true
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "low"
    },
    "claude-opus-5-5": {},
    "claude-sonnet-5-5": {}
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "switchModelsOnFlag": false,
  "skipAutoPermissionPrompt": true,
  "disableDeepLinkRegistration": "disable"
}
