#!/usr/bin/env bash

set -Eeufo pipefail

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Translate ja <-> en
# @raycast.mode fullOutput

# Optional parameters:
# @raycast.icon 🌐
# @raycast.argument1 { "type": "text", "placeholder": "text (ja/en)" }

# Documentation:
# @raycast.author {{ .handle }}
# @raycast.authorURL https://raycast.com/{{ .handle }}

export PATH="${HOME}/.local/bin:${PATH}"
export MISE_EXEC_AUTO_INSTALL=0
export LC_ALL=en_US.UTF-8
text="$1"

ja=${text//[^ぁ-ヿ一-鿿]/}
# shellcheck disable=SC2206
words=(${text//[^A-Za-z]/ })
if ((${#ja} > 0 && ${#ja} >= ${#words[@]})); then
  lang=en
else
  lang=ja
fi

prompt="<|plamo:tag|>dataset<|plamo:msg|>translation<|plamo:tag|>input<|plamo:msg|>$text<|plamo:tag|>output<|plamo:key|>lang<|plamo:val|>$lang<|plamo:msg|>"

# shellcheck disable=SC2016
body=$(mise x -- jq -n --arg prompt "$prompt" \
  '{model: "plamo-3-translate-2b", prompt: $prompt, temperature: 0, stop: ["<|plamo:tag|>", "<|plamo:bos|>"]}')

curl -sf http://127.0.0.1:9931/v1/completions \
  -H 'Content-Type: application/json' \
  -d "$body" | mise x -- jq -r '.choices[0].text'
