{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>h3y6e/renovate-config", ":automergeAll"],
  "schedule": ["at any time"],
  "minimumReleaseAge": "24 hours",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^install\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+=\"[\\w.-]+@(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+=\"v(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["h3y6e/**"],
      "minimumReleaseAge": "0"
    },
    {
      "matchPackageNames": ["ggml-org/llama.cpp"],
      "ignoreUnstable": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["ffmpeg", "imagemagick"],
      "registryUrls": ["https://api.anaconda.org/package/conda-forge"]
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["codex"],
      "extractVersion": "^rust-v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ]
}
